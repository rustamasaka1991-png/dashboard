# Server
PORT=3000
# Admin parol (xodim qo'shish, natija kiritish, sozlamalar uchun). ALBATTA o'zgartiring!
ADMIN_PASSWORD=admin
# Vaqt zonasi siljishi (Toshkent = +5)
TZ_OFFSET_HOURS=5

# OnlinePBX: domen va API kalitni dashboarddagi Sozlamalar sahifasida kiriting.
# Bu yerda yozilgan qiymat Sozlamalardagidan USTUN turadi (u yerda o'zgartirib bo'lmaydi).
# PBX_DOMAIN=pbx12345.onpbx.ru
# PBX_API_KEY=
# PBX_API_BASE=https://api2.onlinepbx.ru

# amoCRM (amoCRM -> amoMarket -> "Xususiy integratsiya" -> uzoq muddatli token)
AMO_SUBDOMAIN=
AMO_TOKEN=
# AMO_BASE_DOMAIN=amocrm.ru

# Vercel / Upstash Redis (Vercel Storage o'zi qo'shadi; kompyuterda kerak emas)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
